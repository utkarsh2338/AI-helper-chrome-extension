{
    "manifest_version": 3,
    "name": "AI Helper",
    "version": "0.1",
    "description": "Context-aware AI assistant for forms",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}